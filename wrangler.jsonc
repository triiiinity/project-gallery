// Cloudflare settings for the project gallery site.
// "single-page-application" sends every address (like /grant or /tdreade) to index.html,
// which then shows the right page.
{
  "name": "project-gallery",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  }
}
